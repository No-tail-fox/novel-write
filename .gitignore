# Pinned upstream trees are imported byte-for-byte and verified by hash on every build
# (scripts/import-lemo-upstream.mjs / import-pixelle-upstream.mjs --verify); never committed.
vendor/lemo-upstream/
vendor/pixelle-upstream/

