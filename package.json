{
  "name": "storydream",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"scripts\\run-npm-node.cmd node_modules/vite/bin/vite.js\" \"wait-on http://127.0.0.1:5173 && scripts\\run-npm-node.cmd node_modules/electron/cli.js .\"",
    "build": "scripts\\run-npm-powershell.cmd scripts/build.ps1",
    "package:win": "scripts\\run-npm-powershell.cmd scripts/package-win.ps1",
    "convert:coze": "scripts\\run-npm-node.cmd scripts/convert-coze-workflows.mjs",
    "fetch:coze:feishu": "scripts\\run-npm-node.cmd scripts/fetch-feishu-coze-workflows.mjs",
    "smoke:electron": "scripts\\run-npm-powershell.cmd scripts/smoke-electron.ps1",
    "smoke:html-video": "scripts\\run-npm-node.cmd node_modules/tsx/dist/cli.mjs scripts/smoke-html-video.ts",
    "qa:html-video-ui": "scripts\\run-npm-powershell.cmd scripts/build.ps1 && scripts\\run-npm-node.cmd node_modules/tsx/dist/cli.mjs scripts/qa-html-video-ui.mjs",
    "qa:editorial": "scripts\\run-npm-powershell.cmd scripts/build.ps1 && scripts\\run-npm-node.cmd node_modules/tsx/dist/cli.mjs scripts/editorial-qa-electron.ts",
    "test": "scripts\\run-npm-powershell.cmd scripts/test.ps1",
    "test:watch": "scripts\\run-npm-powershell.cmd scripts/test-watch.ps1",
    "typecheck": "scripts\\run-npm-powershell.cmd scripts/typecheck.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "sql.js": "^1.14.1",
    "undici": "^6.27.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hyperframes/core": "0.7.83",
    "@hyperframes/lint": "0.7.83",
    "@hyperframes/player": "0.7.83",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "electron": "^41.7.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1",
    "gsap": "3.12.5",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "shell-quote": "1.9.0"
  },
  "build": {
    "appId": "local.storydream",
    "electronDist": "node_modules/electron/dist",
    "productName": "StoryDream",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "node_modules/sql.js/**/*",
      "node_modules/undici/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/python",
        "to": "python"
      }
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    }
  }
}
