{
  "name": "storydream",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"node node_modules/vite/bin/vite.js\" \"wait-on http://127.0.0.1:5173 && node node_modules/electron/cli.js .\"",
    "build": "node scripts/run-powershell.mjs scripts/build.ps1",
    "package:win": "node scripts/run-powershell.mjs scripts/package-win.ps1",
    "convert:coze": "node scripts/convert-coze-workflows.mjs",
    "fetch:coze:feishu": "node scripts/fetch-feishu-coze-workflows.mjs",
    "smoke:electron": "node scripts/run-powershell.mjs scripts/smoke-electron.ps1",
    "test": "node scripts/run-powershell.mjs scripts/test.ps1",
    "test:watch": "node scripts/run-powershell.mjs scripts/test-watch.ps1",
    "typecheck": "node scripts/run-powershell.mjs scripts/typecheck.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sql.js": "^1.14.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron": "^41.7.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.storydream",
    "electronDist": "node_modules/electron/dist",
    "productName": "StoryDream",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-renderer/**/*",
      "dist-electron/**/*",
      "node_modules/sql.js/**/*",
      "node_modules/undici/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/python",
        "to": "python"
      }
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    }
  }
}
